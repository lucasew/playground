FROM golang:1.21-bookworm

WORKDIR /usr/src/app

COPY server_go/go.mod server_go/go.sum ./
COPY server_go ./
COPY --from=ghcr.io/lucasew/playground-rinha202401-tigerbeetle@sha256:ed8c0f9793dc71e2875ef4eefe0c55fbec09f3afaed62d0d53f96121ffc94751 /usr/src/tigerbeetle/src/clients/go/ vendor/github.com/tigerbeetle/tigerbeetle-go
RUN go build -v -o server ./...

ENTRYPOINT ["/usr/src/app/server"]
# FROM scratch
# COPY --from=build /usr/src/app/server /

